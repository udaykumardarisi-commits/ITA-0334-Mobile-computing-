
# TASK 1: Alternative Frequency-Planning Strategies

# Strategy 1: Fixed Cluster Frequency Reuse (Iterative)
def fixed_cluster_reuse(total_channels):
    print("\n1. FIXED CLUSTER FREQUENCY REUSE")

    valid_N = []

    # Search valid cluster sizes: N = i^2 + i*j + j^2
    for i in range(0, 6):
        for j in range(0, 6):
            N = i*i + i*j + j*j
            if N > 0 and N not in valid_N:
                valid_N.append(N)

    valid_N.sort()
    N = next(n for n in valid_N if n <= total_channels)

    print("Valid cluster sizes:", valid_N)
    print("Selected cluster size N:", N)

    # Distribute channels among cells in the cluster
    for cell in range(1, N + 1):
        print("Cell", cell, "gets frequency group", cell)

    print("Principle: Spatial reuse")
    print("Benefit: Simple and predictable frequency planning")


# Strategy 2: Sectorised Frequency Reuse
def sectorised_reuse(total_channels):
    print("\n2. SECTORISED FREQUENCY REUSE")

    sectors = 3
    channels_per_sector = total_channels // sectors

    for sector in range(1, sectors + 1):
        start = (sector - 1) * channels_per_sector + 1
        end = sector * channels_per_sector
        print("Sector", sector, "uses channels", start, "to", end)

    print("Principle: Spatial filtering")
    print("Benefit: Directional antennas reduce interference")


# Strategy 3: Dynamic Channel Assignment
def dynamic_assignment():
    print("\n3. DYNAMIC CHANNEL ASSIGNMENT")

    available_channels = [1, 2, 3, 4, 5]
    cell_channels = {
        "A": [],
        "B": [],
        "C": []
    }

    neighbours = {
        "A": ["B"],
        "B": ["A", "C"],
        "C": ["B"]
    }

    # Simulate channel requests
    requests = ["A", "A", "B", "C", "B", "A"]

    for cell in requests:
        used = []

        for neighbour in neighbours[cell]:
            used += cell_channels[neighbour]

        free = [
            ch for ch in available_channels
            if ch not in cell_channels[cell] and ch not in used
        ]

        if free:
            channel = free[0]
            cell_channels[cell].append(channel)
            print("Cell", cell, "assigned channel", channel)
        else:
            print("Cell", cell, ": No interference-free channel available")

    print("Principle: Trunking and dynamic allocation")
    print("Benefit: Channels are assigned according to demand")


# Strategy 4: Hierarchical Macro-Micro Planning (Recursive)
def plan_cell(cell, demand, capacity):
    print("Cell", cell, "- Demand:", demand, "Capacity:", capacity)

    if demand <= capacity:
        print("  Capacity sufficient; keep this cell")
        return

    print("  Splitting cell into two smaller cells")

    # Recursively divide demand between two smaller cells
    plan_cell(cell + ".1", demand // 2, capacity)
    plan_cell(cell + ".2", demand - demand // 2, capacity)


def macro_micro_planning():
    print("\n4. HIERARCHICAL MACRO-MICRO PLANNING")

    plan_cell("M", demand=20, capacity=6)

    print("Principle: Hierarchical spatial reuse")
    print("Benefit: Adds capacity in busy areas")


# Main program
def main():
    total_channels = 12

    print("FREQUENCY PLANNING SIMULATION")
    print("Total available channels:", total_channels)

    fixed_cluster_reuse(total_channels)
    sectorised_reuse(total_channels)
    dynamic_assignment()
    macro_micro_planning()

    print("\nPREPROCESSING REQUIRED:")
    print("1. Prepare a traffic-demand map")
    print("2. Conduct a radio propagation survey")
    print("3. Create a hexagonal cell layout")
    print("4. Check available spectrum and interference")

    print("\nCOST:")
    print("The mobile network operator pays for surveys,")
    print("planning tools, equipment and network deployment.")


if __name__ == "__main__":
    main()
